# Prompt Vault Server Configuration

# Server Configuration
PORT=3001
PROMPT_VAULT_DB_PATH=./prompt-vault.db

# CORS Configuration
# Comma-separated list of allowed origins (use * for all origins in development)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication Configuration
# JWT secret key (REQUIRED for production - minimum 32 characters)
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=your-secret-key-min-32-characters-long

# JWT token expiration (s=seconds, m=minutes, h=hours, d=days)
JWT_EXPIRES_IN=24h

# Require authentication for all API routes (true/false)
REQUIRE_AUTH=false

# Restrict API access to localhost only (true/false)
LOCALHOST_ONLY=false

# API Keys (optional, alternative to JWT)
# Format: API_KEY_<NAME>=<key_value>
# API_KEY_ADMIN=admin-key-abc123
# API_KEY_READONLY=readonly-key-xyz789

# Audit Logging Configuration
# Enable audit logging for sensitive operations (true/false)
AUDIT_LOGGING_ENABLED=true

# Maximum number of audit events to keep in memory
AUDIT_MAX_EVENTS=10000

# Rate Limiting Configuration
# Enable rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Strict rate limit for sensitive endpoints
RATE_LIMIT_STRICT_MAX_REQUESTS=10
RATE_LIMIT_STRICT_WINDOW_MS=60000

# Observability Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
LOG_LEVEL=info
