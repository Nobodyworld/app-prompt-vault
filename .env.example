# Prompt Vault local configuration
# Copy only the settings you need. Never commit real secrets.

# HTTP server and local persistence
# The supported pre-alpha HTTP entrypoint is loopback-only. Non-loopback hosts fail closed.
PROMPT_VAULT_HOST=127.0.0.1
PORT=3001
PROMPT_VAULT_DB_PATH=./prompt-vault.db
# Optional override for tag/project associations. Defaults beside the main database.
PROMPT_VAULT_TAG_DB_PATH=./prompt-vault-platform.db
PROMPT_VAULT_STATIC_DIR=./desktop/dist
PROMPT_VAULT_ALLOWED_ORIGINS=http://127.0.0.1:1420,http://localhost:1420
PROMPT_VAULT_MAX_FILE_SIZE_BYTES=10485760
PROMPT_VAULT_MAX_PROMPT_CONTENT_LENGTH=102400

# Desktop/browser client
VITE_API_BASE_URL=http://127.0.0.1:3001/api

# Authentication
# Local reads may remain unauthenticated during pre-alpha development; unsafe methods already require credentials.
# Public-network and public-internet deployment are not supported.
# JWT_SECRET is required for JWT issuance. Without it, /auth/token returns 503 and no JWT is issued.
# Use an explicitly injected secret of at least 32 random characters; never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h
REQUIRE_AUTH=false
LOCALHOST_ONLY=true

# Optional API keys. Direct configured-key authentication remains available where supported even if JWT issuance is disabled.
# API_KEY_ADMIN=replace-with-a-random-api-key

# Audit retention (in-memory events)
AUDIT_MAX_EVENTS=10000

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_MS=60000

# Observability
# The standalone observability server also binds to 127.0.0.1 by default.
PROMPT_VAULT_METRICS=false
PROMPT_VAULT_METRICS_PORT=9464
PROMPT_VAULT_LOG_LEVEL=info

# Native renderer telemetry
PROMPT_VAULT_TELEMETRY_ENABLED=true
PROMPT_VAULT_TELEMETRY_RETENTION_DAYS=30
PROMPT_VAULT_TELEMETRY_CLEANUP_INTERVAL_HOURS=24
# Set either opt-out variable to 1 to disable persisted renderer telemetry.
# PROMPT_VAULT_TELEMETRY_OPTOUT=1
# NW_TELEMETRY_OPTOUT=1
