# Nobodyworld OS app .gitignore
# Keep this file consistent across apps/app-*.

# Dependencies
node_modules/
.pnpm/
.npm/
.yarn/

# Monorepo lockfiles (use root pnpm-lock.yaml)
pnpm-lock.yaml
package-lock.json
yarn.lock
npm-shrinkwrap.json

# Turbo
.turbo/

# Build outputs
dist/
build/
out/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
.eslintcache

# Environment
.env
.env.*
!.env.example
.envrc

# Databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Vitest UI outputs
html/

# Tauri / Rust
src-tauri/target/
target/
**/*.rs.bk

# OS files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# Vim swap files
*.swp
*.swo
*~

# Temp
tmp/
temp/
.local/

# Python (if any tooling uses it)
__pycache__/
*.py[cod]
