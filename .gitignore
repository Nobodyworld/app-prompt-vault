# Prompt Vault .gitignore
# Build outputs and dependencies - DO NOT commit these files

#########################################
# NODE.JS / TYPESCRIPT BUILD ARTIFACTS
#########################################

# Dependencies
node_modules/
.npm/
.yarn/
.pnpm/

# Build outputs
dist/
build/
out/
target/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime files
*.pid
*.seed
*.pid.lock
.eslintcache

#########################################
# RUST / TAURI
#########################################

# Rust build outputs
target/
**/*.rs.bk
Cargo.lock

# Tauri build artifacts
src-tauri/target/
*.exe
*.app
*.dmg
*.deb
*.rpm
*.msi

#########################################
# DATABASES & DATA
#########################################

# SQLite files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# Test data
data/
temp-data/

#########################################
# ENVIRONMENT & SECRETS
#########################################

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc

# Secrets and keys
*.pem
*.key
*.p12
*.pfx

#########################################
# OPERATING SYSTEM FILES
#########################################

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*

#########################################
# DEVELOPMENT TOOLS
#########################################

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains
.idea/
*.iws
*.iml
*.ipr

# Vim
*.swp
*.swo
*~

#########################################
# PROJECT-SPECIFIC
#########################################

# Generated files
plugins/
temp/
tmp/

# Development utilities
*.backup
*.bak

