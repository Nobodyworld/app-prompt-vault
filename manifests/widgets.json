{
    "appId": "prompt-vault",
    "widgets": [
        {
            "id": "pv:quick-add",
            "displayName": "Quick Add Prompt",
            "description": "Add a prompt quickly from Hub."
        },
        {
            "id": "pv:recent",
            "displayName": "Recent Prompts",
            "description": "Shows the most recently created prompts.",
            "configSchema": {
                "type": "object",
                "properties": {
                    "limit": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 50,
                        "default": 10
                    }
                }
            }
        },
        {
            "id": "pv:stats",
            "displayName": "Prompt Stats",
            "description": "Overview of prompt totals and activity."
        }
    ]
}
