{
  "name": "prompt-vault",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first prompt vault with versioning, search, desktop, CLI, HTTP, and automation surfaces.",
  "license": "Proprietary",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/copy-migrations.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:summary": "tsx scripts/report-coverage.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "metrics:snapshot": "tsx scripts/metrics-snapshot.ts",
    "repository:audit": "node scripts/repository-audit.mjs",
    "quality:gate": "pnpm repository:audit && pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage && pnpm coverage:summary && pnpm security:scan",
    "validate": "pnpm quality:gate",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "smoke": "node ./scripts/smoke-test-memory.cjs",
    "observability": "PROMPT_VAULT_METRICS=true tsx scripts/observability.ts",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "tags:migrate-legacy": "tsx scripts/migrate-legacy-tags.ts",
    "interop:export": "tsx scripts/export-interop.ts",
    "release:prepare": "tsx scripts/release-prepare.ts",
    "extension:scaffold": "tsx scripts/scaffold-extension.ts",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "desktop:preview-release": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/windows/run-release-preview.ps1",
    "desktop:refresh-installed": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-local-build.ps1",
    "web:dev": "tsx src/server.ts",
    "web:start": "node dist/server.js",
    "web:build": "pnpm desktop:build",
    "tauri:dev": "tsx scripts/tauri-run.ts dev",
    "tauri:build": "tsx scripts/tauri-run.ts build"
  },
  "keywords": [
    "prompt",
    "vault",
    "sqlite",
    "tauri",
    "react",
    "cli"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "@tauri-apps/api": "^2.0.0",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.9.4",
    "simple-git": "^3.30.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-istanbul": "^4.0.5",
    "@vitest/coverage-v8": "^4.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.4"
  }
}
