{
  "name": "prompt-vault",
  "version": "0.2.0",
  "description": "A modular prompt vault domain layer with CLI utilities and SQLite persistence.",
  "license": "Proprietary",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:summary": "tsx scripts/report-coverage.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "metrics:snapshot": "tsx scripts/metrics-snapshot.ts",
    "quality:gate": "npm run lint && npm run build && npm run test:coverage && npm run coverage:summary && npm run security:scan",
    "validate": "npm run quality:gate",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "smoke": "node ./scripts/smoke-test-memory.cjs",
    "observability": "PROMPT_VAULT_METRICS=true tsx scripts/observability.ts",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "release:prepare": "tsx scripts/release-prepare.ts",
    "extension:scaffold": "tsx scripts/scaffold-extension.ts",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "web:dev": "tsx server.ts",
    "web:build": "npm run desktop:build && npm run web:dev",
    "tauri:dev": "tsx scripts/tauri-run.ts dev",
    "tauri:build": "tsx scripts/tauri-run.ts build"
  },
  "keywords": [
    "prompt",
    "vault",
    "sqlite",
    "tauri",
    "react",
    "cli"
  ],
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^3.1.4",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jsdom": "^22.1.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.4"
  }
}
