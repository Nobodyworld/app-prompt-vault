{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Vault",
  "version": "0.1.0",
  "identifier": "com.promptvault.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "powershell -Command \"if (!(Test-Path '../desktop/dist')) { New-Item -ItemType Directory -Path '../desktop/dist' }\" && npm run desktop:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Vault",
        "width": 500,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}