{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Vault",
  "version": "0.2.0",
  "identifier": "com.nobodyworld.promptvault",
  "build": {
    "beforeDevCommand": "pnpm -C .. desktop:dev",
    "beforeBuildCommand": "pnpm -C .. desktop:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Vault",
        "width": 500,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:* ws://localhost:*; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
