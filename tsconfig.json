{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "server.ts", "scripts/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/mcp",
    "tests",
    "tests/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
